{
  "name": "freshdesk-mcp",
  "version": "1.1.0",
  "description": "MCP server for Freshdesk (TypeScript) — supports stdio and Streamable HTTP transports",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "freshdesk-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc --watch",
    "dev:stdio": "tsc && MCP_TRANSPORT=stdio node dist/index.js",
    "dev:http": "tsc && MCP_TRANSPORT=http node dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "freshdesk",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "claude",
    "cursor",
    "helpdesk",
    "typescript"
  ],
  "author": "hashcott",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashcott/freshdesk-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/hashcott/freshdesk-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
